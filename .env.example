# ─────────────────────────────────────────────────────────────────────────────
# CashCanvas — environment variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cashcanvas-change-this-secret

# ── AI (backend only — never use VITE_ prefix for these) ─────────────────────
# Gemini: used by /api/categorize to classify transactions
GEMINI_API_KEY=
# Anthropic: used by /api/parse-pdf to extract transactions from PDFs
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── Google reCAPTCHA v3 ───────────────────────────────────────────────────────
# Register at https://www.google.com/recaptcha/admin → create site → v3
# Leave blank to disable reCAPTCHA (OK for local development)
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=
# Minimum score to accept (0.0–1.0). Lower = less strict. Default 0.5.
RECAPTCHA_MIN_SCORE=0.5

# ── Email verification (Gmail SMTP) ───────────────────────────────────────────
# Leave blank to auto-verify all users (dev mode — no email sent).
#
# How to get a Gmail App Password:
#   1. Enable 2-Step Verification on your Google account
#   2. Google Account → Security → App Passwords
#   3. Create "Mail / Other (CashCanvas)" → copy the 16-char code
GMAIL_USER=paramcharnanand17@gmail.com
GMAIL_APP_PASSWORD=
# Public URL used in verification-email links
APP_URL=http://localhost:5173

# ── CORS (local Express server) ───────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
