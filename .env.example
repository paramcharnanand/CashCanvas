# ─────────────────────────────────────────────────────────────────────────────
# CashCanvas — environment variables
# Copy this file to .env and fill in the values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cashcanvas-change-this-secret

# ── Gemini AI (backend only — never use VITE_ prefix for these) ──────────────
# Used by /api/categorize (transaction classification) and /api/parse-pdf (PDF extraction)
GEMINI_API_KEY=

# ── Google reCAPTCHA v3 (signup only) ────────────────────────────────────────
# Leave blank to skip the check in dev mode.
# Register at https://www.google.com/recaptcha/admin → create site → v3
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── Email OTP (sign-in/sign-up codes, password reset) ─────────────────────────
# Leave every var in this section blank to skip OTP entirely (dev mode — users
# log in without a code). EMAIL_PROVIDER selects the transport ("gmail" or
# "resend"); defaults to "gmail" if unset.
EMAIL_PROVIDER=gmail
EMAIL_FROM=
EMAIL_FROM_NAME=CashCanvas
APP_URL=http://localhost:5173

# gmail provider — how to get a Gmail App Password:
#   1. Enable 2-Step Verification on your Google account
#   2. Google Account → Security → App Passwords
#   3. Create "Mail / Other (CashCanvas)" → copy the 16-char code
GMAIL_USER=
GMAIL_APP_PASSWORD=

# resend provider — better inbox placement via a real transactional provider.
# Sign up at https://resend.com, verify your sending domain, then set
# EMAIL_PROVIDER=resend and EMAIL_FROM to an address on that verified domain.
RESEND_API_KEY=

# ── CORS (local Express server) ───────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
